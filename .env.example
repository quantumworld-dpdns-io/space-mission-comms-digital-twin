# App
APP_NAME=SpaceCommsDigitalTwin
APP_VERSION=0.1.0
DEBUG=false

# API
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8000"]

# Auth
AUTH_SECRET_KEY=change-me-to-a-secure-random-string
AUTH_ALGORITHM=HS256
AUTH_TOKEN_EXPIRE_MINUTES=60

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/app.log

# Quantum Simulation
QUANTUM_BACKENDS=["qiskit","cirq","pennylane","qutip"]
DEFAULT_SIMULATOR_SHOTS=1024
MAX_QUBITS=20

# OWASP ZAP
OWASP_ZAP_URL=http://localhost:8080
OWASP_ZAP_API_KEY=change-me

# Database
DATABASE_URL=sqlite:///data/simulations.db

# Redis
REDIS_URL=redis://localhost:6379/0

# Monitoring
PROMETHEUS_ENABLED=false
SENTRY_DSN=

# CORS
CORS_ORIGINS=["*"]

# Go Server (gRPC)
GO_GRPC_HOST=localhost
GO_GRPC_PORT=50051
